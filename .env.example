# Copy to .env and fill in values. Never commit a real .env.
# All keys are optional except when you want that feature.

# --- app ---
APP_ENV=dev
APP_NAME=WordPressGenius
LOG_LEVEL=INFO
LOG_FILE=logs/wordpressgenius.log
JSON_LOGS=false
ENABLE_FILE_LOGGING=true

# --- WordPress (can also be entered in the UI) ---
WORDPRESS_SITE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=

# --- LLM (leave blank to use the rule-based planner and template copy) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_AGENTIC_ENABLED=true
LLM_FAST_MODEL=
LLM_PREMIUM_MODEL=
LLM_TEMPERATURE_PRECISE=
LLM_TEMPERATURE_CREATIVE=

# --- safety and limits ---
REQUIRE_CONFIRMATION_FOR_MAJOR_CHANGES=true
MAX_REQUESTS_PER_MINUTE=10
MAX_PROMPT_LENGTH=4000
WORDPRESS_MAX_RETRIES=2
WORDPRESS_RETRY_BACKOFF_SECONDS=0.5
BACKUP_DIR=data/backups
BACKUP_KEEP_LAST=25

# --- auth and encryption ---
AUTH_ENABLED=true
AUTH_USERS_PATH=config/users.yml
# Generate with: python -c "from core.security import generate_fernet_key; print(generate_fernet_key())"
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_VAULT_PATH=data/credentials.enc
SITES_VAULT_PATH=data/sites.enc
LLM_SETTINGS_PATH=data/llm_settings.enc

# --- optional integrations ---
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=6
REDIS_URL=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
USAGE_ANALYTICS_ENABLED=false
USAGE_ANALYTICS_PATH=data/usage_analytics.jsonl
WP_CACHE_TTL_SECONDS=60
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8081
